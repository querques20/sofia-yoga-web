# Environment variables. Copy to `.env.local` and fill in: real `.env*` files are git-ignored, this one is
# committed. The public site builds and runs with none of them; the admin (/admin) needs them.

# --- Database (Postgres) ---
# Locally, with `docker compose -f compose.dev.yaml up -d`: postgresql://sofia:sofia@localhost:5434/sofia
DATABASE_URL=
# Direct connection, without a pooler: a pooler cuts the long transactions of a migration. Locally it can be
# the same as DATABASE_URL or stay empty.
DATABASE_URL_UNPOOLED=

# --- Site ---
# Public URL of the site, no trailing slash. Locally http://localhost:3010
NEXT_PUBLIC_SITIO_URL=

# --- Admin (better-auth) ---
# Signs the sessions. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# --- Emails (Resend): "choose your password", "your password changed", the sign-in code ---
# Without a key, outside production, each email is printed whole on the server console (link and code
# included): that is what local work needs. In production, without a key the email does NOT go out.
RESEND_API_KEY=
# The sender, from a domain verified in Resend. Example: Sofia Yoga <no-reply@example.com>
CORREO_REMITENTE=
