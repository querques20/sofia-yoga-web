{
  "name": "sofia-yoga-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "react-doctor": "pnpm dlx react-doctor@0.9.23 --yes --no-supply-chain --blocking warning",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"src/**/*.test.mjs\" && tsx --test \"src/**/*.test.ts\" && pnpm -r --if-present test",
    "prisma": "node scripts/prisma-guard.mjs",
    "migrate": "node scripts/prisma-guard.mjs migrate dev",
    "migrate:deploy": "node scripts/prisma-guard.mjs migrate deploy",
    "generate": "node scripts/prisma-guard.mjs generate",
    "create-account": "tsx scripts/create-account.mts",
    "appoint-director": "tsx scripts/appoint-director.mts",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/client": "7.10.1",
    "@sofia/auth": "workspace:*",
    "@sofia/db": "workspace:*",
    "@sofia/kit-admin": "workspace:*",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.28.12"
}
